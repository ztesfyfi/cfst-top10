CFST_ADMIN_TOKEN=replace-this-with-a-unique-secret-at-least-32-characters
CFST_BIND_ADDRESS=127.0.0.1
CFST_PORT=8765
TZ=Asia/Shanghai

# GitHub Gist publishing (leave empty to disable)
CFST_GIST_ID=
CFST_GITHUB_TOKEN=

# Cloudflare Worker publishing (HTTPS base URL; leave empty to disable)
CFST_CF_WORKER_URL=
CFST_CF_WORKER_TOKEN=

# Publish each successfully generated IP family after a speed test
CFST_AUTO_PUBLISH=false
